rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/projects/{projectId} {
      function ownsProject() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProject() {
        return request.resource.data.keys().hasOnly(['owner', 'name', 'updated', 'document'])
          && request.resource.data.keys().hasAll(['owner', 'name', 'updated', 'document'])
          && request.resource.data.owner == uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.updated is int
          && request.resource.data.document is string && request.resource.data.document.size() < 850000;
      }
      allow read, delete: if ownsProject();
      allow create, update: if ownsProject() && validProject();
    }
  }
}

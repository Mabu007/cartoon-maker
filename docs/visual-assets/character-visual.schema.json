{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "style": {
      "type": "string",
      "enum": [
        "classic",
        "illustrated"
      ]
    },
    "profile": {
      "type": "string",
      "enum": [
        "slim",
        "average",
        "curvy",
        "athletic",
        "muscular",
        "broad",
        "larger",
        "short",
        "tall",
        "young-adult",
        "mature",
        "elderly"
      ]
    },
    "shoulders": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.25
    },
    "waist": {
      "type": "number",
      "minimum": 0.75,
      "maximum": 1.35
    },
    "hips": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.3
    },
    "armWidth": {
      "type": "number",
      "minimum": 0.75,
      "maximum": 1.3
    },
    "thighWidth": {
      "type": "number",
      "minimum": 0.75,
      "maximum": 1.3
    },
    "calfWidth": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.25
    },
    "handSize": {
      "type": "number",
      "minimum": 0.75,
      "maximum": 1.3
    },
    "footSize": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.25
    },
    "neckLength": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.2
    },
    "components": {
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "slot": {
            "type": "string",
            "enum": [
              "hair",
              "top",
              "head-base",
              "upper-arm-left",
              "forearm-left",
              "upper-arm-right",
              "forearm-right",
              "thigh-left",
              "calf-left",
              "thigh-right",
              "calf-right",
              "shoe-left",
              "shoe-right"
            ]
          },
          "view": {
            "type": "string",
            "enum": [
              "front",
              "three-quarter",
              "side",
              "back-quarter",
              "back"
            ]
          },
          "image": {
            "type": "string",
            "maxLength": 450000,
            "pattern": "^data:image\\/(?:png|webp);base64,[A-Za-z0-9+/]+={0,2}$"
          },
          "pivot": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "end": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "width": {
            "type": "number",
            "minimum": 8,
            "maximum": 160
          },
          "height": {
            "type": "number",
            "minimum": 8,
            "maximum": 180
          },
          "offsetX": {
            "type": "number",
            "minimum": -80,
            "maximum": 80
          },
          "offsetY": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "fit": {
            "type": "string",
            "enum": [
              "fixed",
              "body"
            ]
          },
          "profiles": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "slim",
                "average",
                "curvy",
                "athletic",
                "muscular",
                "broad",
                "larger",
                "short",
                "tall",
                "young-adult",
                "mature",
                "elderly"
              ]
            }
          },
          "symmetrical": {
            "type": "boolean"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "slot",
          "view",
          "image",
          "pivot",
          "width",
          "height",
          "offsetX",
          "offsetY",
          "fit",
          "profiles",
          "symmetrical",
          "license",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "limbArt": {
      "type": "string",
      "const": "anatomical-v1"
    }
  },
  "required": [
    "version",
    "style",
    "profile"
  ],
  "additionalProperties": false
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Compatibility reads for voice recordings created before R2 migration.
    // New audio, images and video must be uploaded to the private R2 bucket.
    match /users/{uid}/audio/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
